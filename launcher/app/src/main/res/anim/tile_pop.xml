<?xml version="1.0" encoding="utf-8"?>
<!-- boot_pop_entrance: each tile rises from below, grows from its bottom edge and settles with a soft overshoot. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false"
    android:duration="560">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0"
        android:duration="320"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <translate android:fromYDelta="70%" android:toYDelta="0%"
        android:interpolator="@anim/pop_overshoot" />
    <scale
        android:fromXScale="0.86" android:toXScale="1.0"
        android:fromYScale="0.86" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="100%"
        android:interpolator="@anim/pop_overshoot" />
</set>
